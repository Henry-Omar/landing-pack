# Copy to .env (or export) before deploying. All values are OPTIONAL — sensible defaults are used.
# For a quick local run you need nothing; just `python3 server.py`.

# Network
PORT=8000
HOST=0.0.0.0

# Public base URL (used for Stripe success/cancel redirects)
APP_BASE_URL=http://localhost:8000

# Payments
#   mock   = instant fake checkout (default, no keys needed)
#   stripe = real Stripe Checkout (requires the two keys below + `pip install stripe`)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# WeChat Pay (V3) — set all three to enable; notifications verified with APIv3 key
WECHAT_MCH_ID=
WECHAT_APIV3_KEY=
WECHAT_APP_ID=
# Alipay — set app id + secret to enable; notify verified via HMAC-SHA256
ALIPAY_APP_ID=
ALIPAY_APP_SECRET=
ALIPAY_PUBLIC_KEY=
